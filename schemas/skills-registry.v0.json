{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-charter.dev/schemas/skills-registry.v0.json",
  "title": "Skills Charter Registry",
  "description": "Generated package inventory for a Git-backed Agent Skill library.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "source",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://skills-charter.dev/schemas/skills-registry.v0.json"
    },
    "schema_version": {
      "type": "string",
      "const": "skills-charter.registry.v0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "entrypoint",
        "description",
        "lifecycle",
        "risk",
        "risk_reasons",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*/SKILL\\.md$"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "topics": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "candidate",
            "in_review",
            "draft",
            "review",
            "approved",
            "rejected",
            "deprecated",
            "retired"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "candidate",
            "in_review",
            "approved",
            "rejected",
            "deprecated",
            "retired"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_type": {
              "type": "string",
              "enum": [
                "manual",
                "public_import",
                "generated",
                "evolved",
                "internal_template"
              ]
            },
            "source_url": {
              "type": "string"
            },
            "source_commit": {
              "type": "string"
            },
            "imported_at": {
              "type": "string"
            },
            "imported_by": {
              "type": "string"
            },
            "generator": {
              "type": "string"
            },
            "upstream": {
              "type": "string"
            },
            "approved_by": {
              "type": "string"
            },
            "approved_at": {
              "type": "string"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evals",
            "reports",
            "review_notes",
            "trigger_samples"
          ],
          "properties": {
            "evals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reports": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "review_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "trigger_samples": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "install": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^npx skills add "
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "entrypoint",
            "supporting",
            "script",
            "asset",
            "evidence"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
