{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skilldocs.dev/schemas/skills-registry.v0.json",
  "title": "Agent SkillDocs Registry",
  "description": "Generated package inventory for a Git-backed Agent Skill library.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "source",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://agent-skilldocs.dev/schemas/skills-registry.v0.json"
    },
    "schema_version": {
      "type": "string",
      "const": "skilldocs.registry.v0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "entrypoint",
        "description",
        "risk",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*/SKILL\\.md$"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "install": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^npx skills add "
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "entrypoint",
            "supporting",
            "script",
            "asset"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
